[Unit]
Description=Job Auto-Flow
After=network-online.target

[Service]
WorkingDirectory=/home/imranh/job-auto-flow
ExecStart=/home/imranh/job-auto-flow/.venv/bin/python app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

